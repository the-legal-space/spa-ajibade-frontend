    },
    {
      "page": "/practice-areas",
      "regex": "^/practice\\-areas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/practice\\-areas(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/responsible-business",
      "regex": "^/responsible\\-business(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/responsible\\-business(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/terms",
