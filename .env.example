# Public content API. Safe to expose: every public endpoint is unauthenticated.
NEXT_PUBLIC_API_BASE_URL=https://spaaco.onrender.com/api/v1

# The canonical site URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://spaajibade.com

# Label for the exact consent wording shown on the forms. Change it whenever the wording changes.
NEXT_PUBLIC_CONSENT_TEXT_VERSION=v1-2026-09

# Cloudflare Turnstile site key. Leave empty while the captcha is switched off on the API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret the backend sends when content changes (POST /api/revalidate).
REVALIDATE_SECRET=change-me

# Placeholder "Pro Bono & Community Commitment" stories for the Responsible Business page
# (src/lib/mock/csr-stories.ts). Default: on locally and in Vercel previews, off on Vercel production.
# MOCK_CSR=on   # force on (e.g. a production demo)
# MOCK_CSR=off  # force off

# ---- "Discuss a Mandate" email (nodemailer, route: /api/discuss) ----
# SMTP login. Works with Gmail (use an App Password) or any SMTP provider.
MAIL_USER=thelegalspace01@gmail.com
MAIL_PASS=ictn iilh xcxe rzkm
# Defaults: smtp.gmail.com on port 465 (SSL). For Brevo use smtp-relay.brevo.com and 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# The "from" address. Defaults to MAIL_USER (Gmail only sends as the logged-in account or a verified alias).
# MAIL_FROM="SPA Ajibade & Co." <bookings@spaajibade.com>
# Optional extra inbox copied on every attorney email (e.g. the front office).
# MAIL_BCC=frontoffice@spaajibade.com
# While testing: both emails go to this address instead of the real attorney / client.
# MAIL_TEST_RECIPIENT=you@example.com
# Build and log the emails without sending anything.
# MAIL_DRY_RUN=1
# Browsers allowed to call /api/discuss from another origin (comma separated). Needed only when
# the site is served statically and the page calls this route on a different host.
# MAIL_ALLOWED_ORIGINS=https://spaajibade.com
# Static deployment: where the page posts the booking. Default is this site's own /api/discuss.
# NEXT_PUBLIC_MAIL_API_URL=https://api.spaajibade.com/api/discuss

# "Forward to another associate" link in the attorney email. Signed with this secret; if unset it is
# derived from MAIL_PASS. Set your own long random string in production.
# MAIL_SIGNING_SECRET=
# Domains a booking may be forwarded to (comma separated). Default: spaajibade.com. Ignored while
# MAIL_TEST_RECIPIENT is set. The forward link points at NEXT_PUBLIC_SITE_URL, so that must be the
# public address of the site (not localhost) in production.
# MAIL_FORWARD_DOMAINS=spaajibade.com
