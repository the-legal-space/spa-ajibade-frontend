# Public content API. Safe to expose: every public endpoint is unauthenticated.
NEXT_PUBLIC_API_BASE_URL=https://spaaco.onrender.com/api/v1

# The canonical site URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://spaajibade.com

# Label for the exact consent wording shown on the forms. Change it whenever the wording changes.
NEXT_PUBLIC_CONSENT_TEXT_VERSION=v1-2026-09

# Cloudflare Turnstile site key. Leave empty while the captcha is switched off on the API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret the backend sends when content changes (POST /api/revalidate).
REVALIDATE_SECRET=change-me

# Placeholder "Pro Bono & Community Commitment" stories for the Responsible Business page
# (src/lib/mock/csr-stories.ts). Default: on locally and in Vercel previews, off on Vercel production.
# MOCK_CSR=on   # force on (e.g. a production demo)
# MOCK_CSR=off  # force off
